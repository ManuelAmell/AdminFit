# Base de datos. Usar SIEMPRE el rol de aplicación (no superusuario): Postgres ignora RLS
# para superusuarios y se pierde el aislamiento entre gimnasios.
#   Docker:        docker compose up -d postgres  -> postgres://adminfit_app:adminfit_app@localhost:5432/adminfit
#   Local (initdb): pnpm db:local init && pnpm db:local start -> postgres://adminfit_app@127.0.0.1:5433/adminfit
DATABASE_URL="postgres://adminfit_app:adminfit_app@localhost:5432/adminfit"

# Better Auth (Fase 1)
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
